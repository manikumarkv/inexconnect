---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  /** Link prefix: "./" from the index and post pages, "../" from archive pages. */
  base?: string;
}
const { post, base = "./" } = Astro.props as Props;
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<article class="flex flex-col rounded-[20px] border border-line border-t-4 border-t-coral bg-white p-7 shadow-[0_10px_30px_rgb(35_35_35/0.06)]">
  <p class="text-sm text-slate">{formatDate(post.data.date)}</p>
  <h3 class="mt-2 text-2xl font-bold">
    <a href={`${base}${post.id}`} class="hover:text-coral">{post.data.headline ?? post.data.title}</a>
  </h3>
  {post.data.summary && <p class="mt-3 flex-1 leading-relaxed text-slate">{post.data.summary}</p>}
  <a href={`${base}${post.id}`} class="mt-5 font-semibold text-charcoal underline decoration-coral decoration-2 underline-offset-4 hover:text-coral">
    Read post →
  </a>
</article>
