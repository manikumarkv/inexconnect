---
// Fixed reading-progress bar + back-to-top button (mirrors the DevRunway blog).
---

<div class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[3px]" aria-hidden="true">
  <span data-progress class="block h-full origin-left scale-x-0 bg-coral"></span>
</div>
<a
  href="#top"
  data-to-top
  hidden
  aria-label="Back to top"
  class="fixed right-4 bottom-4 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white text-charcoal shadow-[0_10px_30px_rgb(35_35_35/0.15)] hover:text-coral"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
</a>

<script>
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  const top = document.querySelector<HTMLElement>("[data-to-top]");
  const article = document.querySelector<HTMLElement>("article");
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    if (bar) bar.style.transform = `scaleX(${p})`;
    if (top) top.hidden = scrollY < innerHeight * 1.5;
  };
  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  addEventListener("resize", update);
  update();
</script>
