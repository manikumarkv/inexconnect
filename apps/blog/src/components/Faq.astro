---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props as Props;
---

{items.length > 0 && (
  <section class="mt-12" aria-labelledby="faq">
    <h2 id="faq" class="text-2xl font-extrabold tracking-tight">Frequently asked questions</h2>
    <div class="mt-4">
      {items.map((f: { question: string; answer: string }) => (
        <details class="group border-t border-line py-4 last:border-b">
          <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 [&::-webkit-details-marker]:hidden">
            <h3 class="font-bold">{f.question}</h3>
            <span class="text-xl leading-none text-slate group-open:hidden">+</span>
            <span class="hidden text-xl leading-none text-slate group-open:inline">−</span>
          </summary>
          <div class="mt-2 leading-relaxed text-slate">
            {f.answer.split(/\n{2,}/).map((para: string) => <p class="mb-2 last:mb-0">{para}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
