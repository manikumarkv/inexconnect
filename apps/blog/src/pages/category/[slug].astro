---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";

type Post = CollectionEntry<"posts">;

interface Props {
  name: string;
  posts: Post[];
}

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection("posts"))
    .filter((post: Post) => !post.data.draft && post.data.date <= now)
    .sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());
  const byCategory: Map<string, { name: string; posts: Post[] }> = new Map();
  for (const post of posts) {
    if (!post.data.category) continue;
    const slug = post.data.category
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
    const entry = byCategory.get(slug) ?? { name: post.data.category, posts: [] as Post[] };
    entry.posts.push(post);
    byCategory.set(slug, entry);
  }
  return [...byCategory.entries()].map(([slug, entry]) => ({
    params: { slug },
    props: { name: entry.name, posts: entry.posts } as Props,
  }));
}

const { name, posts } = Astro.props as Props;
---

<BaseLayout title={name} description={`Posts in ${name} on the iNexConnect blog.`} path={`/category/${slugify(name)}`}>
  <section class="bg-charcoal text-white">
    <div class="wrap py-16 sm:py-20">
      <p class="eyebrow">Category</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-extrabold tracking-tight">{name}</h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-white/75">{posts.length} post{posts.length === 1 ? "" : "s"}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-2">
        {posts.map((post: Post) => <PostCard post={post} base="../" />)}
      </div>
      <p class="mt-10">
        <a href="../" class="font-semibold text-charcoal underline decoration-coral decoration-2 underline-offset-4 hover:text-coral">← All posts</a>
      </p>
    </div>
  </section>
</BaseLayout>
