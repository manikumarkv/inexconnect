---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Callout from "../components/Callout.astro";
import Steps from "../components/Steps.astro";
import Step from "../components/Step.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import KeyTakeaways from "../components/KeyTakeaways.astro";
import Faq from "../components/Faq.astro";
import Toc from "../components/Toc.astro";
import SeriesBox from "../components/SeriesBox.astro";
import SeriesNav from "../components/SeriesNav.astro";
import PostNav from "../components/PostNav.astro";
import AuthorCard from "../components/AuthorCard.astro";
import ShareButtons from "../components/ShareButtons.astro";
import Newsletter from "../components/Newsletter.astro";
import PostCard from "../components/PostCard.astro";
import seriesData from "../data/series.json";

type Post = CollectionEntry<"posts">;

interface Props {
  post: Post;
  parts: Post[];
  related: Post[];
  newer?: Post;
  older?: Post;
}

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection("posts"))
    .filter((post: Post) => !post.data.draft && post.data.date <= now)
    .sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post: Post, idx: number) => {
    const parts = post.data.series
      ? posts
          .filter((p: Post) => p.data.series === post.data.series)
          .sort((a: Post, b: Post) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0))
      : [];
    const related = posts
      .filter((p: Post) => p.id !== post.id)
      .map((p: Post) => {
        let score = 0;
        if (post.data.category && p.data.category === post.data.category) score += 2;
        const mine = new Set(post.data.tags.map((t: { id: string }) => t.id));
        score += p.data.tags.filter((t: { id: string }) => mine.has(t.id)).length;
        return { p, score };
      })
      .sort((a: { score: number }, b: { score: number }) => b.score - a.score)
      .slice(0, 3)
      .map((x: { p: Post }) => x.p);
    return {
      params: { slug: post.id },
      props: {
        post,
        parts,
        related,
        newer: posts[idx - 1],
        older: posts[idx + 1],
      } as Props,
    };
  });
}

const { post, parts, related, newer, older } = Astro.props as Props;
const { Content, headings } = await render(post);
const title = post.data.headline ?? post.data.title;
const description = post.data.seoDescription ?? post.data.summary;
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const author = post.data.author ? await getEntry(post.data.author) : undefined;
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readTime = `${Math.max(1, Math.round(words / 200))} min read`;
const initials = (author?.data.name ?? "")
  .split(/\s+/)
  .map((w: string) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const categorySlug = post.data.category ? slugify(post.data.category) : undefined;
const seriesEntry = post.data.series
  ? seriesData.find((s: { name: string }) => s.name === post.data.series)
  : undefined;
const seriesHref = seriesEntry ? `./series/${seriesEntry.slug}` : undefined;

interface TocItem {
  id: string;
  label: string;
  level: 2 | 3;
}
const tocItems: TocItem[] = headings
  .filter((h: MarkdownHeading) => h.depth === 2 || h.depth === 3)
  .map((h: MarkdownHeading) => ({ id: h.slug, label: h.text, level: h.depth as 2 | 3 }));
if (post.data.faq.length > 0) tocItems.push({ id: "faq", label: "FAQ", level: 2 });
const showToc = post.data.showToc && tocItems.length >= 3;

const canonical = `https://inexconnect.com/blog/${post.id}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: post.data.date.toISOString(),
    ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
    ...(author ? { author: { "@type": "Person", name: author.data.name } } : {}),
    mainEntityOfPage: canonical,
  },
  ...(post.data.faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: post.data.faq.map((f: { question: string; answer: string }) => ({
            "@type": "Question",
            name: f.question,
            acceptedAnswer: { "@type": "Answer", text: f.answer },
          })),
        },
      ]
    : []),
];
---

<BaseLayout title={post.data.seoTitle ?? title} description={description} path={`/${post.id}`}>
  <Fragment slot="head">
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </Fragment>

  <ReadingProgress />

  <div id="top" class="wrap py-10 sm:py-12">
    <div class:list={["gap-10", showToc ? "lg:grid lg:grid-cols-[minmax(0,1fr)_280px]" : ""]}>
      <article class="post mx-auto w-full max-w-3xl lg:mx-0">
        <header>
          <Breadcrumbs
            items={[
              { name: "Home", url: "./" },
              ...(post.data.category
                ? [{ name: post.data.category, url: `./category/${categorySlug}` }]
                : []),
              { name: title },
            ]}
          />
          {post.data.category && (
            <p class="mt-6">
              <a href={`./category/${categorySlug}`} class="eyebrow hover:text-charcoal">{post.data.category}</a>
            </p>
          )}
          <h1 class="mt-3 text-4xl font-extrabold tracking-tight">{title}</h1>
          {post.data.summary && <p class="mt-4 text-lg leading-relaxed text-slate">{post.data.summary}</p>}
          <div class="mt-6 flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-charcoal text-sm font-extrabold text-white" aria-hidden="true">
              {initials}
            </span>
            <div>
              <p class="font-semibold">
                {author ? <a href={`./authors/${author.id}`} rel="author" class="hover:text-coral">{author.data.name}</a> : "iNexConnect"}
              </p>
              <p class="text-sm text-slate">
                {formatDate(post.data.date)}
                {post.data.updated && <span> · Updated {formatDate(post.data.updated)}</span>}
                <span> · {readTime}</span>
              </p>
            </div>
          </div>
          {post.data.coverImage && (
            <img src={post.data.coverImage} alt={post.data.coverAlt ?? ""} class="mt-8 w-full rounded-[20px]" />
          )}
        </header>

        {post.data.series && seriesHref && parts.length > 0 && (
          <SeriesBox
            name={post.data.series}
            seriesHref={seriesHref}
            parts={parts.map((p: Post) => ({ id: p.id, title: p.data.headline ?? p.data.title }))}
            currentId={post.id}
          />
        )}

        <KeyTakeaways items={post.data.tldr} />

        <div class="post-body">
          <Content components={{ Callout, Steps, Step }} />
        </div>

        <Faq items={post.data.faq} />

        <footer class="mt-12 space-y-8">
          <div class="flex flex-wrap items-center justify-between gap-4">
            {post.data.tags.length > 0 ? (
              <ul class="flex flex-wrap gap-2" aria-label="Tags">
                {post.data.tags.map((tag: { id: string }) => (
                  <li>
                    <a href={`./tags/${tag.id}`} class="rounded-full bg-mist px-4 py-1.5 text-sm font-medium text-charcoal hover:text-coral">
                      {tag.id}
                    </a>
                  </li>
                ))}
              </ul>
            ) : <span />}
            <ShareButtons url={canonical} title={title} />
          </div>

          <a
            class="inline-block text-sm text-slate underline decoration-coral decoration-2 underline-offset-4 hover:text-coral"
            href={`https://github.com/manikumarkv/inexconnect/edit/release/1/apps/blog/src/content/posts/${post.id}.mdx`}
            rel="noopener"
            target="_blank"
          >
            Suggest an edit on GitHub
          </a>

          {author && (
            <AuthorCard
              name={author.data.name}
              role={author.data.role}
              bio={author.data.bio}
              href={`./authors/${author.id}`}
            />
          )}

          <Newsletter />

          {post.data.series && seriesHref && parts.length > 0 ? (
            <SeriesNav
              name={post.data.series}
              seriesHref={seriesHref}
              parts={parts.map((p: Post) => ({ id: p.id, title: p.data.headline ?? p.data.title }))}
              currentId={post.id}
            />
          ) : (
            <PostNav
              newer={newer ? { id: newer.id, title: newer.data.headline ?? newer.data.title } : undefined}
              older={older ? { id: older.id, title: older.data.headline ?? older.data.title } : undefined}
            />
          )}
        </footer>
      </article>

      {showToc && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <Toc items={tocItems} />
          </div>
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="related-h">
        <h2 id="related-h" class="text-2xl font-extrabold tracking-tight">Related posts</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {related.map((p: Post) => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </div>

  <script>
    // Render Mermaid flowcharts: swap each mermaid code block for its SVG.
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (blocks.length > 0) {
      const { default: mermaid } = await import("mermaid");
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        themeVariables: {
          primaryColor: "#f7f7f8",
          primaryBorderColor: "#ff5c50",
          primaryTextColor: "#232323",
          secondaryColor: "#ffffff",
          tertiaryColor: "#ffffff",
          mainBkg: "#f7f7f8",
          nodeBorder: "#ff5c50",
          lineColor: "#5b5b60",
          textColor: "#232323",
          clusterBkg: "#ffffff",
          clusterBorder: "#e4e4e7",
          fontFamily: "inherit",
        },
      });
      let i = 0;
      for (const pre of blocks) {
        const code = pre.querySelector("code")?.textContent ?? "";
        const wrap = document.createElement("div");
        wrap.className = "mermaid-figure";
        try {
          const { svg } = await mermaid.render(`mmd-${i++}`, code.trim());
          wrap.innerHTML = svg;
        } catch {
          wrap.textContent = code;
        }
        pre.replaceWith(wrap);
      }
    }
  </script>
</BaseLayout>
