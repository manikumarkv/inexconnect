---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
}

export async function getStaticPaths() {
  type Post = CollectionEntry<"posts">;
  const now = new Date();
  const posts = (await getCollection("posts")).filter(
    (post: Post) => !post.data.draft && post.data.date <= now,
  );
  const tagIdSet = new Set<string>();
  for (const post of posts) {
    for (const t of post.data.tags as { id: string }[]) {
      tagIdSet.add(t.id);
    }
  }
  const tagIds: string[] = [...tagIdSet];
  return tagIds.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((post: Post) => post.data.tags.some((t: { id: string }) => t.id === tag)),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as Props;
const sorted = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`Posts tagged “${tag}”`} path={`/tags/${tag}`}>
  <section class="py-14 sm:py-16">
    <div class="wrap">
      <p class="eyebrow">Tag</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight">{tag}</h1>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {sorted.map((post) => (
          <article class="flex flex-col rounded-[20px] border border-line border-t-4 border-t-coral bg-white p-7 shadow-[0_10px_30px_rgb(35_35_35/0.06)]">
            <p class="text-sm text-slate">{formatDate(post.data.date)}</p>
            <h2 class="mt-2 text-2xl font-bold">
              <a href={`../${post.id}`} class="hover:text-coral">{post.data.headline ?? post.data.title}</a>
            </h2>
            {post.data.summary && <p class="mt-3 flex-1 leading-relaxed text-slate">{post.data.summary}</p>}
            <a href={`../${post.id}`} class="mt-5 font-semibold text-charcoal underline decoration-coral decoration-2 underline-offset-4 hover:text-coral">
              Read post →
            </a>
          </article>
        ))}
      </div>
      <p class="mt-10">
        <a href="../" class="font-semibold text-charcoal underline decoration-coral decoration-2 underline-offset-4 hover:text-coral">← All posts</a>
      </p>
    </div>
  </section>
</BaseLayout>
