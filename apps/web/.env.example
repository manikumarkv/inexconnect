# Blog origin for the /blog rewrites (plan Phase 3). Leave unset until the
# blog is deployed. Production value: https://blog.inexconnect.com
BLOG_ORIGIN=

# Tawk.to live chat — from the Tawk.to dashboard (public values, not secrets).
# When either is unset, no chat widget is loaded at all.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
