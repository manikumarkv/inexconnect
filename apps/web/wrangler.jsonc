{
  // Cloudflare Workers deployment for the website (OpenNext adapter).
  // Production: inexconnect-web · Dev: inexconnect-web-dev (deployed with --name)
  "name": "inexconnect-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
